# ---- NEXUS-SOC: Docker Compose settings ----
# Copy to .env, then: docker compose up -d --build

# Ports on your machine
APP_PORT=3000
API_PORT=8000

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata

# Database / cache (internal to the compose network)
POSTGRES_DB=soc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=soc-postgres-password
REDIS_PASSWORD=soc-redis-password
REDIS_DB=1

# ---- LLM providers (all optional) ----
# With no key the agents use the built-in offline engine. Keys can also be
# added later in the UI: Admin -> Platform settings -> LLM providers.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Pause per offline agent step (ms) so audiences can follow the live timeline; 0 = full speed
AGENT_OFFLINE_STEP_DELAY_MS=700
