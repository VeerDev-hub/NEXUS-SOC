# Backend settings for LOCAL development (scripts/start-dev.ps1 copies this to .env).
# For Docker Compose use the .env.example at the repository root instead.

DJANGO_SECRET_KEY=local-dev-secret-key-change-me-0123456789abcdef
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata

# PostgreSQL from development/docker/compose.yaml.
# If a native PostgreSQL already uses 5432, set POSTGRES_HOST_PORT=5433 in
# development/docker/.env and use 5433 here.
POSTGRES_DB=soc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=soc-dev-postgres-password
# Use 127.0.0.1 (not localhost) so WSL or native services on ::1 are not picked up.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=soc-dev-redis-password

# Object storage (only needed for file attachments)
RUSTFS_ENDPOINT_URL=http://127.0.0.1:9000
RUSTFS_BUCKET=soc
RUSTFS_ACCESS_KEY=soc
RUSTFS_SECRET_KEY=soc-dev-rustfs-password
RUSTFS_REGION=us-east-1

# ---- LLM providers (optional; the offline engine is used when none is set) ----
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
GEMINI_API_KEY=

# Pause per offline agent step (ms) for live demos; 0 = full speed
AGENT_OFFLINE_STEP_DELAY_MS=700

# ---- Alert emails ---------------------------------------------------------------
# Sent when the agent team's verdict is in ALERT_EMAIL_VERDICTS at or above
# ALERT_EMAIL_MIN_SEVERITY. Leave EMAIL_HOST empty to print emails to the worker console.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords)
# and use it as EMAIL_HOST_PASSWORD. Test with: python manage.py send_test_email
EMAIL_HOST=
# EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=NEXUS-SOC <you@gmail.com>
ALERT_EMAIL_TO=
# ALERT_EMAIL_TO=soc-team@example.com,lead@example.com
ALERT_EMAIL_MIN_SEVERITY=High
ALERT_EMAIL_VERDICTS=True Positive,Suspicious
SOC_CONSOLE_URL=http://localhost:3000

# ---- Live log detection (python manage.py run_live_detection) -----------------
# Syslog listener; point rsyslog/syslog-ng/firewalls at UDP or TCP <this host>:5514. 0 disables.
LIVE_SYSLOG_PORT=5514
# Log files to follow, comma separated, globs allowed (auth.log, nginx access.log, JSON lines).
LIVE_TAIL_FILES=
# Windows Event Log: auto (on when running on Windows), on, off. Security needs Administrator.
LIVE_WINDOWS_EVENTLOG=auto
# LIVE_WINDOWS_CHANNELS=Security,System,Microsoft-Windows-PowerShell/Operational,Microsoft-Windows-Windows Defender/Operational
# Seconds before the same rule fires again for the same source
LIVE_DETECTION_COOLDOWN_SECONDS=600
